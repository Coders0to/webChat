<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MeetMe - Sign In / Sign Up</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#c45acb;
  --primary2:#e47ad8;
  --dark:#34203d;
  --muted:#9c8fa3;
  --soft:#fff8ff;
}
body{
  min-height:100vh;
  font-family:Poppins,sans-serif;
  background:linear-gradient(135deg,#ead7e4 0%,#f7e9f3 48%,#ddd5f5 100%);
  display:flex;align-items:center;justify-content:center;
  overflow-x:hidden;color:var(--dark);
}
body:before,body:after{
  content:"";position:fixed;border-radius:50%;pointer-events:none;
}
body:before{
  width:280px;height:280px;left:-130px;top:-110px;
  border:55px solid rgba(255,255,255,.3);
}
body:after{
  width:330px;height:330px;right:-170px;bottom:-170px;
  border:45px solid rgba(196,90,203,.10);
}

.auth-card{
  width:min(1180px,92vw);min-height:650px;
  background:rgba(255,255,255,.88);
  border-radius:28px;
  box-shadow:0 30px 80px rgba(104,66,110,.18);
  display:grid;grid-template-columns:43% 57%;
  overflow:hidden;position:relative;
  animation:cardIn .8s ease both;
}
@keyframes cardIn{from{opacity:0;transform:translateY(25px) scale(.97)}to{opacity:1;transform:none}}

.form-side{padding:55px 65px;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:5}
.logo{display:flex;align-items:center;gap:10px;font-size:26px;font-weight:700;margin-bottom:28px}
.logo-icon{
  width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
  color:white;background:linear-gradient(135deg,var(--primary),#9c55c9);
  box-shadow:0 8px 20px rgba(196,90,203,.25);
}
.logo span{color:var(--primary)}

h1{font-size:32px;line-height:1.2;margin-bottom:7px}
.subtitle{font-size:13px;color:var(--muted);margin-bottom:24px}

.switcher{
  height:49px;border:1px solid #e4b9e5;border-radius:14px;padding:4px;
  display:grid;grid-template-columns:1fr 1fr;margin-bottom:18px;
  background:#fff;
}
.switcher button{
  border:0;background:transparent;border-radius:10px;font:600 14px Poppins;
  color:var(--dark);cursor:pointer;transition:.35s;
}
.switcher button.active{
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  color:#fff;box-shadow:0 7px 16px rgba(196,90,203,.25);
}

.form{display:none;animation:fadeUp .35s ease}
.form.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.field{position:relative;margin:11px 0}
.field input{
  width:100%;height:55px;border:1px solid #eaddeb;border-radius:13px;
  padding:0 45px 0 43px;outline:none;background:#fff;font:13px Poppins;
  transition:.25s;
}
.field input:focus{border-color:#d37bd6;box-shadow:0 0 0 4px rgba(211,123,214,.10)}
.field .icon{position:absolute;left:16px;top:17px;color:#c26bc8;font-size:17px}
.eye{position:absolute;right:16px;top:18px;color:#95899c;cursor:pointer;font-size:15px}

.options{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#777;margin:13px 0 17px}
.remember{display:flex;gap:7px;align-items:center}
.remember input{accent-color:var(--primary)}
.options a,.bottom a{color:var(--primary);font-weight:600;text-decoration:none}

.submit{
  width:100%;height:56px;border:0;border-radius:13px;
  color:#fff;font:600 15px Poppins;cursor:pointer;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  box-shadow:0 10px 22px rgba(196,90,203,.25);
  transition:.25s;
}
.submit:hover{transform:translateY(-2px);box-shadow:0 14px 28px rgba(196,90,203,.32)}
.submit:active{transform:scale(.98)}

.divider{display:flex;align-items:center;gap:12px;color:#b6aab9;font-size:12px;margin:21px 0}
.divider:before,.divider:after{content:"";height:1px;background:#eadfea;flex:1}

.socials{display:flex;gap:15px}
.social{
  flex:1;height:51px;border:1px solid #eadfea;background:#fff;border-radius:13px;
  cursor:pointer;font-size:20px;transition:.25s;
}
.social:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(80,50,90,.09)}
.facebook{color:#1877f2}.apple{color:#111}.google{color:#4285f4}

.bottom{text-align:center;font-size:12px;color:#999;margin-top:20px}
.bottom a{cursor:pointer}

.art-side{position:relative;overflow:hidden;background:linear-gradient(145deg,#fff8ff,#f8edf8)}
.art-side:before{
  content:"";position:absolute;width:540px;height:540px;border-radius:50%;
  border:25px solid rgba(211,103,213,.10);left:70px;top:45px;
  animation:spin 25s linear infinite;
}
.art-side:after{
  content:"";position:absolute;width:400px;height:400px;border-radius:50%;
  border:2px dashed rgba(207,101,211,.55);left:140px;top:115px;
  animation:spinReverse 18s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes spinReverse{to{transform:rotate(-360deg)}}

.hero-photo{
  position:absolute;width:300px;height:300px;border-radius:50%;left:180px;top:150px;
  object-fit:cover;border:14px solid #e283dd;
  box-shadow:0 20px 45px rgba(148,77,151,.20);
  z-index:2;animation:float 4s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

.orbit{
  position:absolute;width:520px;height:520px;left:70px;top:40px;border-radius:50%;
  animation:orbit 20s linear infinite;z-index:3;pointer-events:none;
}
.avatar{
  position:absolute;width:76px;height:76px;border-radius:50%;object-fit:cover;
  border:4px solid white;box-shadow:0 8px 25px rgba(83,49,88,.22);
}
.a1{left:62px;top:55px}.a2{right:32px;top:65px}.a3{right:10px;bottom:95px}.a4{left:95px;bottom:25px}
@keyframes orbit{to{transform:rotate(360deg)}}

.float-icon{
  position:absolute;z-index:4;color:#d16ed2;animation:bob 3s ease-in-out infinite;
}
.paper{left:80px;top:285px;font-size:45px;transform:rotate(-15deg)}
.pin{right:65px;top:190px;font-size:34px}
.chat{right:105px;bottom:80px;background:#b65ec3;color:#fff;padding:9px 14px;border-radius:30px;font-size:17px}
@keyframes bob{50%{transform:translateY(-12px) rotate(3deg)}}

.signup-extra{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.success{display:none;color:#9a55a2;text-align:center;font-size:13px;margin-top:12px}

@media(max-width:900px){
  .auth-card{grid-template-columns:1fr;max-width:560px}
  .art-side{display:none}
  .form-side{padding:45px 35px}
}
@media(max-width:480px){
  .auth-card{width:94vw;border-radius:20px}
  .form-side{padding:30px 22px}
  h1{font-size:27px}
  .signup-extra{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="auth-card">
  <section class="form-side">
    <div class="logo"><div class="logo-icon">☁</div>Meet<span>Me</span></div>

    <h1 id="title">Welcome back</h1>
    <p class="subtitle" id="subtitle">Please enter your login details below</p>

    <div class="switcher">
      <button id="signinTab" class="active">Sign In</button>
      <button id="signupTab">Sign Up</button>
    </div>

    <!-- SIGN IN -->
    <form id="signinForm" class="form active">
      <div class="field">
        <span class="icon">♙</span>
        <input type="text" placeholder="Username or email" required>
      </div>
      <div class="field">
        <span class="icon">♙</span>
        <input id="loginPass" type="password" placeholder="Password" required>
        <span class="eye" onclick="togglePassword('loginPass',this)">◉</span>
      </div>

      <div class="options">
        <label class="remember"><input type="checkbox"> Remember me</label>
        <a href="#">Forgot Password?</a>
      </div>

      <button class="submit" type="submit">Sign In</button>

      <div class="divider"><span>or</span></div>
      <div class="socials">
        <button class="social facebook" type="button">f</button>
        <button class="social apple" type="button">●</button>
        <button class="social google" type="button">G</button>
      </div>

      <p class="bottom">Don't have an account? <a onclick="showSignup()">Sign up</a></p>
    </form>

    <!-- SIGN UP -->
    <form id="signupForm" class="form">
      <div class="signup-extra">
        <div class="field"><span class="icon">♙</span><input type="text" placeholder="First name" required></div>
        <div class="field"><span class="icon">♙</span><input type="text" placeholder="Last name" required></div>
      </div>
      <div class="field"><span class="icon">@</span><input type="email" placeholder="Email address" required></div>
      <div class="field"><span class="icon">♙</span><input id="signupPass" type="password" placeholder="Create password" required><span class="eye" onclick="togglePassword('signupPass',this)">◉</span></div>
      <div class="field"><span class="icon">♙</span><input id="confirmPass" type="password" placeholder="Confirm password" required></div>

      <div class="options">
        <label class="remember"><input type="checkbox" required> I agree to the terms</label>
      </div>

      <button class="submit" type="submit">Create Account</button>
      <p class="bottom">Already have an account? <a onclick="showSignin()">Sign in</a></p>
    </form>
  </section>

  <section class="art-side">
    <img class="hero-photo" src="https://images.unsplash.com/photo-1496440737103-cd596325d314?auto=format&fit=crop&w=700&q=85" alt="Profile">
    <div class="orbit">
      <img class="avatar a1" src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=200&q=80">
      <img class="avatar a2" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=200&q=80">
      <img class="avatar a3" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=200&q=80">
      <img class="avatar a4" src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=200&q=80">
    </div>
    <div class="float-icon paper">➤</div>
    <div class="float-icon pin">●</div>
    <div class="float-icon chat">•••</div>
  </section>
</div>

<script>
const signinTab=document.getElementById('signinTab');
const signupTab=document.getElementById('signupTab');
const signinForm=document.getElementById('signinForm');
const signupForm=document.getElementById('signupForm');
const title=document.getElementById('title');
const subtitle=document.getElementById('subtitle');

function showSignin(){
  signinTab.classList.add('active'); signupTab.classList.remove('active');
  signinForm.classList.add('active'); signupForm.classList.remove('active');
  title.textContent='Welcome back';
  subtitle.textContent='Please enter your login details below';
}
function showSignup(){
  signupTab.classList.add('active'); signinTab.classList.remove('active');
  signupForm.classList.add('active'); signinForm.classList.remove('active');
  title.textContent='Create account';
  subtitle.textContent='Join us and start meeting new people';
}
signinTab.onclick=showSignin;
signupTab.onclick=showSignup;

function togglePassword(id,el){
  const input=document.getElementById(id);
  input.type=input.type==='password'?'text':'password';
  el.textContent=input.type==='password'?'◉':'◌';
}

signinForm.addEventListener('submit',e=>{
  e.preventDefault();
  alert('Sign in form submitted!');
});
signupForm.addEventListener('submit',e=>{
  e.preventDefault();
  if(document.getElementById('signupPass').value!==document.getElementById('confirmPass').value){
    alert('Passwords do not match!');
    return;
  }
  alert('Account created successfully!');
});
</script>
</body>
</html>