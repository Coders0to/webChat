<%- include('layouts/header-date.ejs') %>

<link rel="stylesheet" href="/public/css/profile.css">

<main class="main-content">

  <!-- PAGE CONTENT -->
  <div class="profile-wrapper">

    <!-- Left Image Section -->
    <div class="image-card">
      <img src="<%= user.photo %>" id="profileImg" class="profileImg">

      <div class="image-list">
        <% if (user.photos && user.photos.length) { %>
          <% user.photos.forEach(img => { %>
            <img src="<%= img %>">
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Right Info Section -->
    <div class="info-card">

      <div class="top">
        <h1 id="profileName1"><%= user.name %> <%= userDetails.age %></h1>
        <p id="profileAddress"><%= user.location %></p>
      </div>

      <div class="status" id="onlineStatus">
          <% if (user.is_online == 1) { %>
              <span class="online"></span>
              <span>Online Now</span>
          <% } else { %>
              <span class="offline"></span>
              <span>Offline</span>
          <% } %>
      </div>

      <div class="bio">
        <h3 id="profileBio">Bio</h3>
        <p><%= userDetails.bio %></p>
      </div>

      <div class="info-grid">
        <div><strong>Height</strong><span><%= userDetails.height %></span></div>
        <div><strong>Profession</strong><span><%= userDetails.profession %></span></div>
        <div><strong>Education</strong><span><%= userDetails.education %></span></div>
        <div><strong>Goal</strong><span><%= userDetails.goal %></span></div>
      </div>

      <div class="interest">
        <% if (user.interests && user.interests.length) { %>
          <% user.interests.forEach(i => { %>
            <span><%= i %></span>
          <% }) %>
        <% } %>
      </div>

      <div class="actions">
        <button class="like" data-id="<%= user._id %>">💖 Like</button>
        <button class="chat">💬 Chat</button>
      </div>

    </div>

  </div>

</main>

<script src="/public/js/common.js"></script>
<script src="/public/js/profile.js"></script>

