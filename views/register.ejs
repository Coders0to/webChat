    <!-- =========================================
         PASSWORD TOGGLE
    ========================================= -->

    <script>

        function togglePassword(id, element) {

            const input = document.getElementById(id);

            if (!input) {
                return;
            }

            if (input.type === "password") {

                input.type = "text";

                element.textContent = "◌";

            } else {

                input.type = "password";

                element.textContent = "◉";

            }
        }

    </script>


    <!-- =========================================
         LOGIN / REGISTER SWITCH
    ========================================= -->

    <script>

        const loginTab =
            document.getElementById("show-login");

        const registerTab =
            document.getElementById("show-register");

        const loginSection =
            document.getElementById("user-login");

        const registerSection =
            document.getElementById("register-section");

        const title =
            document.getElementById("title");

        const subtitle =
            document.getElementById("subtitle");


        function showLogin() {

            loginTab.classList.add("active");

            registerTab.classList.remove("active");

            loginSection.classList.add("active");

            registerSection.classList.remove("active");

            title.textContent =
                "Welcome back";

            subtitle.textContent =
                "Please enter your login details below";

        }


        function showRegister() {

            registerTab.classList.add("active");

            loginTab.classList.remove("active");

            registerSection.classList.add("active");

            loginSection.classList.remove("active");

            title.textContent =
                "Create account";

            subtitle.textContent =
                "Join us and start meeting new people";

        }


        loginTab.addEventListener(
            "click",
            showLogin
        );


        registerTab.addEventListener(
            "click",
            showRegister
        );


        document
            .getElementById("login-to-register")
            .addEventListener(
                "click",
                function (e) {

                    e.preventDefault();

                    showRegister();

                }
            );


        document
            .getElementById("register-to-login")
            .addEventListener(
                "click",
                function (e) {

                    e.preventDefault();

                    showLogin();

                }
            );

    </script>


    <!-- =========================================
         LOCATION SEARCH
         Existing API/AJAX ko yahan connect kar sakte ho
    ========================================= -->

    <script>

        const locationInput =
            document.getElementById("locationInput");

        const locationSuggestions =
            document.getElementById("locationSuggestions");

        const latitudeInput =
            document.getElementById("latitude");

        const longitudeInput =
            document.getElementById("longitude");


        let locationTimer = null;


        if (locationInput) {

            locationInput.addEventListener(
                "input",
                function () {

                    const query =
                        this.value.trim();

                    clearTimeout(locationTimer);


                    if (query.length < 2) {

                        locationSuggestions.style.display =
                            "none";

                        locationSuggestions.innerHTML =
                            "";

                        return;
                    }


                    /*
                     * Yahan aapka existing location AJAX
                     * code use ho sakta hai.
                     *
                     * Example:
                     *
                     * $.ajax({
                     *     url: "/location-search",
                     *     data: {
                     *         search: query
                     *     },
                     *     success: function(response) {
                     *
                     *     }
                     * });
                     */


                    locationTimer =
                        setTimeout(
                            function () {

                                /*
                                 * Existing authentic.js mein
                                 * agar location API already hai,
                                 * to usko override nahi karna.
                                 */

                            },
                            300
                        );

                }
            );

        }


        document.addEventListener(
            "click",
            function (event) {

                if (
                    locationSuggestions &&
                    !locationInput.contains(event.target) &&
                    !locationSuggestions.contains(event.target)
                ) {

                    locationSuggestions.style.display =
                        "none";

                }

            }
        );

    </script>


